---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---
<section class="border-b border-line">
  <div class="mx-auto max-w-7xl px-6 py-20 md:py-28 lg:px-8">
    <p class="mono flex items-center gap-3 text-signal">
      <span class="h-px w-8 bg-signal/50"></span>
      {eyebrow}
    </p>
    <h1 class="mt-7 max-w-4xl text-balance text-[2.5rem] font-semibold leading-[1.03] tracking-[-0.02em] text-bright md:text-[3.75rem]">
      {title}
    </h1>
    {description && <p class="mt-7 max-w-2xl text-lg leading-8 text-muted">{description}</p>}
    <slot />
  </div>
</section>
