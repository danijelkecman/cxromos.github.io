---
interface Props {
  title: string;
  /** Index shown in the panel header strip, e.g. "01". */
  index?: string;
  /** Optional right-aligned label in the header strip. */
  meta?: string;
}
const { title, index, meta } = Astro.props;
---
<article class="panel ticks flex flex-col">
  {(index || meta) && (
    <header class="panel-head">
      <span class="mono text-faint">{index}</span>
      {meta && <span class="mono text-signal">{meta}</span>}
    </header>
  )}
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-lg font-semibold leading-snug text-bright">{title}</h3>
    <div class="mt-3 leading-7 text-muted">
      <slot />
    </div>
  </div>
</article>
