---
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/insights', label: 'Insights' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' }
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---
<header class="sticky top-0 z-50 border-b border-line bg-canvas/95 backdrop-blur">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-4 lg:px-8" aria-label="Main navigation">
    <a href="/" class="flex items-center gap-3">
      <span class="mono flex h-8 w-8 items-center justify-center border border-line-strong text-signal">Cx</span>
      <span class="font-semibold tracking-[0.08em] text-bright">CXROMOS</span>
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {nav.map((item) => (
        <a
          class:list={[
            'mono transition-colors',
            isActive(item.href) ? 'text-signal' : 'text-muted hover:text-bright'
          ]}
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </div>

    <a
      href="mailto:danijel@cxromos.com"
      class="mono hidden rounded-chip border border-line-strong px-4 py-2.5 text-body transition-colors hover:border-signal hover:text-bright lg:inline-flex"
    >
      danijel@cxromos.com
    </a>

    <button
      id="nav-toggle"
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-chip border border-line-strong text-body transition-colors hover:border-signal hover:text-bright md:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Toggle navigation menu"
    >
      <svg id="nav-icon-open" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg id="nav-icon-close" viewBox="0 0 24 24" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </nav>

  <div id="mobile-nav" hidden class="border-t border-line bg-ink px-6 pb-6 pt-2 md:hidden">
    <div class="flex flex-col">
      {nav.map((item, i) => (
        <a
          class:list={[
            'mono flex items-center gap-4 border-b border-line py-4 transition-colors',
            isActive(item.href) ? 'text-signal' : 'text-body hover:text-bright'
          ]}
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          <span class="text-faint">{String(i + 1).padStart(2, '0')}</span>
          {item.label}
        </a>
      ))}
      <a href="mailto:danijel@cxromos.com" class="mono py-4 text-signal">danijel@cxromos.com</a>
    </div>
  </div>
</header>
<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  toggle?.addEventListener('click', () => {
    if (!toggle || !menu) return;
    const nowHidden = menu.toggleAttribute('hidden');
    toggle.setAttribute('aria-expanded', String(!nowHidden));
    iconOpen?.classList.toggle('hidden', !nowHidden);
    iconClose?.classList.toggle('hidden', nowHidden);
  });
</script>
