---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';

const posts = (await getCollection('insights')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
---
<BaseLayout title="Insights - CxRomos, LLC" description="Technical notes from CxRomos, LLC on aerospace and satellite intelligence, risk and financial systems, markets, IoT, telemetry, graph routing, and real-time operations.">
  <PageHeader eyebrow={`Insights · ${posts.length} notes`} title="Technical notes for operational intelligence." />

  <div class="mx-auto max-w-7xl px-6 py-16 md:py-20 lg:px-8">
    <div class="panel overflow-hidden">
      <div class="grid gap-px bg-line">
        {posts.map((post, i) => (
          <a
            href={`/insights/${post.id}`}
            class="group grid gap-3 bg-panel px-6 py-6 transition-colors hover:bg-raised md:grid-cols-[11rem_1fr] md:gap-8"
          >
            <div class="mono flex items-center gap-3 text-faint md:pt-2">
              <span>{String(posts.length - i).padStart(2, '0')}</span>
              <time datetime={isoDate(post.data.date)}>{isoDate(post.data.date)}</time>
            </div>
            <div>
              <h2 class="text-xl font-semibold leading-snug text-bright transition-colors group-hover:text-signal">
                {post.data.title}
              </h2>
              <p class="mt-2 leading-7 text-muted">{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
