---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import PageHeader from '../components/PageHeader.astro';
---
<BaseLayout title="Contact - CxRomos, LLC">
  <PageHeader
    eyebrow="Contact"
    title="Discuss a serious technical problem."
    description="For technical partnerships, product development, aerospace and satellite systems, OSINT, risk and financial applications, IoT, edge, telemetry, or advisory work."
  >
    <address class="mt-10 not-italic leading-7 text-muted">
      <div class="font-semibold text-bright">CxRomos, LLC</div>
      <div>131 Continental Dr</div>
      <div>Suite 305</div>
      <div>Newark, DE 19713 US</div>
    </address>
    <div class="mt-10">
      <Button href="mailto:danijel@cxromos.com">danijel@cxromos.com</Button>
    </div>
  </PageHeader>
</BaseLayout>
