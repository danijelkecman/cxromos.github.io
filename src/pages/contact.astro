---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---
<BaseLayout title="Contact - CxRomos, LLC">
  <section class="mx-auto max-w-4xl px-6 py-28 lg:px-8">
    <p class="mb-3 text-sm font-semibold uppercase tracking-[0.24em] text-signal">Contact</p>
    <h1 class="text-5xl font-semibold tracking-tight text-white md:text-6xl">Discuss a serious technical problem.</h1>
    <p class="mt-6 text-xl leading-8 text-slate-300">For technical partnerships, product development, aerospace and satellite systems, OSINT, risk and financial applications, IoT, edge, telemetry, or advisory work.</p>
    <address class="mt-10 not-italic leading-7 text-slate-300">
      <div class="font-semibold text-white">CxRomos, LLC</div>
      <div>131 Continental Dr</div>
      <div>Suite 305</div>
      <div>Newark, DE 19713 US</div>
    </address>
    <div class="mt-10">
      <Button href="mailto:danijel@cxromos.com">danijel@cxromos.com</Button>
    </div>
  </section>
</BaseLayout>
