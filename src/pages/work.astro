---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
---
<BaseLayout title="Work - CxRomos, LLC" description="CxRomos, LLC builds aerospace and satellite intelligence, risk and financial systems, and IoT, edge, and telemetry platforms.">
  <Section eyebrow="Work" title="Focused capabilities, not a menu of generic services." description="These are the areas where CxRomos, LLC should be judged: operational reasoning, geospatial and market intelligence, financial systems, connected devices, and AI workflows that survive contact with reality. Every engagement starts the same way - mapping the decision logic before choosing the tools.">
    <div class="grid gap-6 lg:grid-cols-3">
      <Card title="Aerospace & satellite intelligence">Satellite-derived data, graph-based routing, spatial corridor search, waypoint logic, telemetry, risk overlays, and map-driven operational interfaces.</Card>
      <Card title="Risk, markets & banking applications">OSINT collection, market monitoring, private-credit and operational risk analysis, banking products, financial workflows, and explainable alerting.</Card>
      <Card title="IoT, edge devices & telemetry">Sensor fleets, edge processing, live state, notifications, offline-aware mobile systems, device operations, and backend event infrastructure.</Card>
    </div>
  </Section>
</BaseLayout>
