---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import PageHeader from '../components/PageHeader.astro';
---
<BaseLayout title="Work - CxRomos, LLC" description="CxRomos, LLC builds aerospace and satellite intelligence, risk and financial systems, and IoT, edge, and telemetry platforms.">
  <PageHeader
    eyebrow="Work"
    title="Focused capabilities, not a menu of generic services."
    description="These are the areas where CxRomos, LLC should be judged: operational reasoning, geospatial and market intelligence, financial systems, connected devices, and AI workflows that survive contact with reality. Every engagement starts the same way - mapping the decision logic before choosing the tools."
  />

  <div class="mx-auto max-w-7xl px-6 py-16 md:py-20 lg:px-8">
    <div class="grid gap-5 lg:grid-cols-3">
      <Card index="01" meta="aerospace" title="Aerospace & satellite intelligence">
        Satellite-derived data, graph-based routing, spatial corridor search, waypoint logic, telemetry, risk overlays, and map-driven operational interfaces.
      </Card>
      <Card index="02" meta="risk" title="Risk, markets & banking applications">
        OSINT collection, market monitoring, private-credit and operational risk analysis, banking products, financial workflows, and explainable alerting.
      </Card>
      <Card index="03" meta="iot" title="IoT, edge devices & telemetry">
        Sensor fleets, edge processing, live state, notifications, offline-aware mobile systems, device operations, and backend event infrastructure.
      </Card>
    </div>
  </div>
</BaseLayout>
